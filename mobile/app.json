{
  "expo": {
    "name": "Memorial Storyteller",
    "slug": "memorial-storyteller",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memorialstoryteller.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture photo of your loved one for portrait animation.",
        "NSMicrophoneUsageDescription": "Used to record voice notes and tribute messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.memorialstoryteller.app"
    }
  }
}
